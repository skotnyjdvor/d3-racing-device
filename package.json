{
  "name": "d3-racing-device",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 4173",
    "start:server": "node server/api.mjs",
    "start:render": "node server/api.mjs",
    "test": "node --test",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "build": "vite build",
    "tracks:import": "node scripts/convert-ztracks.mjs",
    "ios:sync": "npm run build && cap sync ios && node scripts/configure-ios.mjs",
    "ios:open": "cap open ios",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop:dev": "npm run desktop:prepare && electron desktop/app",
    "desktop:build": "npm run desktop:prepare && electron-builder --config desktop/electron-builder.yml",
    "icons": "electron scripts/render-icons.cjs && npx --yes @capacitor/assets@3 generate --assetPath resources --android --ios --iconBackgroundColor #08080c --iconBackgroundColorDark #08080c --splashBackgroundColor #08080c --splashBackgroundColorDark #08080c"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.0.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
